# Supabase credentials — OPTIONAL.
# Without these, BottleZero runs in device-only mode (data saved on the device).
# With them, accounts + cloud sync + challenges are enabled.
# Find both values in your Supabase dashboard: Project Settings -> API.
# The anon key is the public/publishable key; it is safe to ship in a client app.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
